{
  "name": "maze-riot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src shared server tests index.html vite.config.js package.json README.md .github",
    "format:check": "prettier --check src shared server tests index.html vite.config.js package.json README.md .github",
    "test:graphics": "node tests/graphics.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
